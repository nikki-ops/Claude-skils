[
{
"text": "Студент потратил всю стипендию на сто будильников.",
"start": 0.063,
"end": 2.428
},
{
"text": "И ни один не завёл для себя.",
"start": 2.459,
"end": 3.705
},
{
"text": "Общага ржала: «В часовщики подался?»",
"start": 3.769,
"end": 5.586
},
{
"text": "Завтра экзамен у профессора Громова.",
"start": 5.668,
"end": 7.233
},
{
"text": "Он валит половину курса.",
"start": 7.265,
"end": 8.414
},
{
"text": "Но у Громова две слабости.",
"start": 8.446,
"end": 9.66
},
{
"text": "Он живёт в преподавательском крыле — прямо за стенкой комнаты номер тринадцать.",
"start": 9.691,
"end": 12.629
},
{
"text": "А в правилах университета написано: если экзаменатор опоздал на пятнадцать минут — студенты свободны.",
"start": 12.661,
"end": 16.748
},
{
"text": "Ночью студент расставил будильники вдоль стены.",
"start": 16.811,
"end": 18.736
},
{
"text": "Час ночи — первый.",
"start": 18.799,
"end": 19.712
},
{
"text": "Час ноль три — второй.",
"start": 19.775,
"end": 20.755
},
{
"text": "Каждые три минуты — новый звонок.",
"start": 20.787,
"end": 22.319
},
{
"text": "Громов стучал в стену.",
"start": 22.351,
"end": 23.408
},
{
"text": "Искал, откуда звенит.",
"start": 23.451,
"end": 24.488
},
{
"text": "Накрывался подушкой.",
"start": 24.53,
"end": 25.475
},
{
"text": "В пять утра звонки стихли.",
"start": 25.507,
"end": 26.787
},
{
"text": "И профессор наконец уснул.",
"start": 26.819,
"end": 28.091
},
{
"text": "Девять утра.",
"start": 28.123,
"end": 28.726
},
{
"text": "Аудитория.",
"start": 28.758,
"end": 29.361
},
{
"text": "Громова нет.",
"start": 29.424,
"end": 30.059
},
{
"text": "Девять ноль пять.",
"start": 30.09,
"end": 30.82
},
{
"text": "Девять десять.",
"start": 30.852,
"end": 31.582
},
{
"text": "Девять пятнадцать.",
"start": 31.645,
"end": 32.597
},
{
"text": "Декан переносит экзамен на неделю.",
"start": 32.629,
"end": 34.165
},
{
"text": "Общага, которая ржала, неделю учит.",
"start": 34.228,
"end": 36.005
},
{
"text": "А студент спит.",
"start": 36.037,
"end": 36.929
},
{
"text": "Через неделю Громов купил беруши.",
"start": 36.96,
"end": 38.437
},
{
"text": "А студент — барабан.",
"start": 38.468,
"end": 39.6
}
]