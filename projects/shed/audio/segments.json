[
{
"text": "Парень сделал свой садовый сарай лучшим рестораном Лондона.",
"start": 0.063,
"end": 2.617
},
{
"text": "Не приготовив ни одного блюда.",
"start": 2.679,
"end": 4.051
},
{
"text": "Раньше ему платили по десять фунтов — за фальшивые отзывы чужим кафе.",
"start": 4.114,
"end": 6.875
},
{
"text": "И он подумал: а что, если отзывы будут на ресторан, которого нет?",
"start": 6.896,
"end": 9.673
},
{
"text": "Он фотографирует «блюда».",
"start": 9.736,
"end": 10.761
},
{
"text": "Пена для бритья.",
"start": 10.792,
"end": 11.533
},
{
"text": "Таблетки для посудомойки.",
"start": 11.554,
"end": 12.64
},
{
"text": "Губка для посуды.",
"start": 12.671,
"end": 13.465
},
{
"text": "А одно блюдо — его собственная нога.",
"start": 13.485,
"end": 15.156
},
{
"text": "Адреса нет.",
"start": 15.187,
"end": 15.765
},
{
"text": "«Только по записи».",
"start": 15.785,
"end": 16.546
},
{
"text": "Друзья смеялись: «Шеф-повар губок».",
"start": 16.608,
"end": 18.352
},
{
"text": "Но писали отзывы.",
"start": 18.383,
"end": 19.303
},
{
"text": "Сарай ползёт вверх.",
"start": 19.334,
"end": 20.305
},
{
"text": "Восемнадцать тысячное место.",
"start": 20.336,
"end": 21.735
},
{
"text": "Тысячное.",
"start": 21.756,
"end": 22.341
},
{
"text": "Сотое.",
"start": 22.403,
"end": 22.873
},
{
"text": "Столиков нет — значит, все хотят столик.",
"start": 22.904,
"end": 24.689
},
{
"text": "Телефон разрывается.",
"start": 24.721,
"end": 25.8
},
{
"text": "И однажды утром его сарай — номер один в Лондоне.",
"start": 25.82,
"end": 28.19
},
{
"text": "Выше тысяч настоящих ресторанов.",
"start": 28.222,
"end": 29.845
},
{
"text": "Тогда он всё-таки открылся.",
"start": 29.865,
"end": 31.158
},
{
"text": "На один вечер.",
"start": 31.178,
"end": 31.783
},
{
"text": "Купил в супермаркете готовые обеды по фунту.",
"start": 31.803,
"end": 33.672
},
{
"text": "Разогрел в микроволновке.",
"start": 33.704,
"end": 34.754
},
{
"text": "Подал.",
"start": 34.817,
"end": 35.114
},
{
"text": "Гости спрашивали, можно ли прийти ещё.",
"start": 35.145,
"end": 36.823
},
{
"text": "Это реальная история.",
"start": 36.854,
"end": 37.8
}
]